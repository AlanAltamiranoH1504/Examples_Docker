# ! ARCHIVO DE DOCKERIZACION DE APLICACION
# * PARTIMOS DE IMAGEN BASE DE NODEJS
FROM node:20.11-alpine3.19

# * NOS MOVEMOS AL DIRECTORIO APP DENTRO DEL CONTENEDOR
WORKDIR /app

# * COPIAMOS LOS ARCHIVOS RELEVANTES DE LA APLICACION DENTRO DEL DIRECTORIO AL QUE NOS MOVIMOS (/app)
COPY package.json ./

# * REALIAZAMOS LA INSTALACION DE DEPENDENCIAS QUE VIENE EN EL PACKAGE.JSON
RUN npm install

# * COPIAMOS EL ARCHIVO app.js DENTRO DEL DIRECTORIO DEL CONTENEDOR (/app)
# COPY app.js ./

# * COPIAMOS TODOSO LOS ARCHIVOS
COPY . .

# * REALIZAMOS LA EJECUCION DE PRUEBAS (TESTING)
RUN npm run test

# * EJECUTAMOS LA APLICACION 
CMD [ "node", "app.js" ] 

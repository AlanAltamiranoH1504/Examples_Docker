# ! ARCHIVO DE DOCKERIZACION DE APLICACION
# ? PRIMERA ETAPA DE STAGE
# * PARTIMOS DE IMAGEN BASE DE NODEJS
FROM node:20.11-alpine3.19 AS devdeps
# FROM --platform=$BUILDPLATFORM node:20.11-alpine3.19
# * NOS MOVEMOS AL DIRECTORIO APP DENTRO DEL CONTENEDOR
WORKDIR /app
# * COPIAMOS LOS ARCHIVOS RELEVANTES DE LA APLICACION DENTRO DEL DIRECTORIO AL QUE NOS MOVIMOS (/app)
COPY package.json ./
# * REALIAZAMOS LA INSTALACION DE DEPENDENCIAS QUE VIENE EN EL PACKAGE.JSON (DEV Y PROD)
RUN npm install


# ? SEGUNDA ETAPA DE STAGE (GENERAMOS UNA NUEVA ENTIDAD DE LINUX)
FROM node:20.11-alpine3.19 AS buildtesting
# * NOS MOVEMOS AL DIRECTORIO APP
WORKDIR /app
# * HACEMOS REFERENCIA A LA ETAPA ANTERIOR QUE YA INSTALO LAS DEPENDENCIAS (COPIAMOS EL STATE ANTERIOR EN LA DIRECCION ACTUAL)
COPY --from=devdeps /app/node_modules ./node_modules
# * COPIAMOS TODO LO QUE HAY EN EL HOST
COPY . .
# * EJECUTAMOS LOS TEST
RUN npm run test


# ? TERCERA ETAPA CONSTRUCCION FINAL DE LA APLICACION
FROM node:20.11-alpine3.19 AS proddeps
WORKDIR /app
COPY package.json ./
# * REALIZAMOS LA INSTALACION DE DEPENDENCIAS DE PRODUCCION UNICAMENTE
RUN npm install --prod


# ? CUARTA ETAPA DE LA CONSTRUCCION
FROM node:20.11-alpine3.19 AS runner
WORKDIR /app
# * COPIAMOS LA DEPDENDENCIAS DE PRODUCCION
COPY --from=proddeps /app/node_modules ./node_modules
# * COPIAMOS LOS ARCHIVOS LOCALES
COPY app.js  ./
COPY tasks/ ./tasks
COPY package.json ./
# * EJECUTAMOS LA APLICACION 
CMD [ "node", "app.js" ] 
